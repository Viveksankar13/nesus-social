# ===========================
# AI Social Media Platform – .gitignore
# ===========================

# ── Database Local Files ──────────────────
*.db
*.sqlite
*.sqlite3
backend/nexus_dev.db

# ── Environment & Secrets ──────────────────
.env
.env.local
.env.production
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Python ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyc
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Node.js / Next.js ────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# ── Docker ──────────────────────────────
docker-compose.override.yml

# ── IDEs & Editors ───────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS ──────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Testing ─────────────────────────────
.playwright/
playwright-report/
test-results/

# ── Build artifacts ──────────────────────
docs/pdf/*.pdf
docs/diagrams/*.png
docs/diagrams/*.svg
!docs/diagrams/.gitkeep

# ── Uploads ──────────────────────────────
uploads/
backend/uploads/

# ── Virtual environments ─────────────────
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# ── Alembic ──────────────────────────────
