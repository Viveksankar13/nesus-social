# ===========================
# Frontend Environment Variables – .env.example
# Copy to .env.local and fill in real values. NEVER commit .env.local
# ===========================

# ── Backend (private — rewrite target, not exposed to browser) ───
BACKEND_URL=http://localhost:8000
# On Vercel: set to your Render backend URL e.g. https://socialmedia-backend.onrender.com

# ── Backend (public — SSE stream only) ──────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# On Vercel: set to your Render backend URL
# Why public? SSE connections go directly browser → backend.
# All other API calls go through Next.js /api/* rewrites (first-party cookies).

# ── App Branding ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Nexus Social
