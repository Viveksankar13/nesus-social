# ===========================
# Backend Environment Variables – .env.example
# Copy to .env and fill in real values. NEVER commit .env
# ===========================

# ── App ──────────────────────────────────
ENVIRONMENT=development
# Set to "production" on Render

# ── Database ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://socialmedia:devpassword@localhost:5432/socialmedia
# On Render, use the provided connection string.
# Note: Render gives postgres:// — the app auto-converts to postgresql+asyncpg://

# ── JWT ──────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── CORS / Frontend ──────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── SMTP (local: use Mailpit) ────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nexussocial.dev
SMTP_FROM_NAME=Nexus Social
SMTP_USE_TLS=false

# Production SMTP options:
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true
# Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465

# ── Gemini AI ────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_QUOTA=100

# ── Moderation ───────────────────────────
MODERATION_FAIL_MODE=open
# "open" = allow content when Gemini is unavailable
# "closed" = block content when Gemini is unavailable

# ── Admin Seed Account ───────────────────
ADMIN_EMAIL=admin@nexussocial.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Rate Limits ──────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_RESEND_VERIFICATION=3/minute
RATE_LIMIT_AI=20/minute

# ── Optional Observability ───────────────
# SENTRY_DSN=https://...@sentry.io/...
